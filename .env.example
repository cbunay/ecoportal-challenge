# Time zone the calendar renders in (IANA name). Leave unset to use the browser's zone.
# NEXT_PUBLIC_CALENDAR_TIME_ZONE=America/Guayaquil
# NEXT_PUBLIC_CALENDAR_TIME_ZONE=America/Mexico_City  # GMT-6
# NEXT_PUBLIC_CALENDAR_TIME_ZONE=Europe/Madrid
# NEXT_PUBLIC_CALENDAR_TIME_ZONE=Asia/Tokyo

# Process time zone for the Jest tests. Defaults to America/Guayaquil.
# TZ=America/Guayaquil

# Port Playwright starts the app on. Defaults to 3000.
# PLAYWRIGHT_PORT=3000
